<launch>
    <!-- ===== USB Port 宣告(要改裝置就改這裡) ===== -->
    <arg name="arduino_port" default="/dev/arduino" />
    <arg name="cam1_device" default="/dev/video0" />
    <arg name="cam2_device" default="/dev/video2" />

    <!-- rosserial_python 節點 -->
    <node pkg="rosserial_python" type="serial_node.py" name="arduino_mega_serial_node" output="screen">
        <param name="port" value="$(arg arduino_port)"/>
        <param name="baud" value="115200"/>
    </node>

    <!-- 統一的攝影機影像發布節點 -->
    <arg name="use_two_cameras" default="true" />
    
    <!-- Camera 1 args -->
    <arg name="cam1_fps" default="30" />
    <arg name="cam1_width" default="640" />
    <arg name="cam1_height" default="480" />

    <!-- Camera 2 args -->
    <arg name="cam2_fps" default="30" />
    <arg name="cam2_width" default="640" />
    <arg name="cam2_height" default="480" />

    <node name="camera1" pkg="camera" type="camera.py" output="screen">
        <param name="camera_id" value="$(arg cam1_device)" />
        <param name="camera_name" value="camera" />
        <param name="frame_rate" value="$(arg cam1_fps)" />
        <param name="width" value="$(arg cam1_width)" />
        <param name="height" value="$(arg cam1_height)" />
    </node>
    
    <node name="camera2" pkg="camera" type="camera.py" output="screen" if="$(arg use_two_cameras)">
        <param name="camera_id" value="$(arg cam2_device)" />
        <param name="camera_name" value="camera2" />
        <param name="frame_rate" value="$(arg cam2_fps)" />
        <param name="width" value="$(arg cam2_width)" />
        <param name="height" value="$(arg cam2_height)" />
    </node>

    <!-- 車道辨識節點 -->
    <node pkg="lane_follower" type="lane_detect_v2.py" name="lane_detect_node" output="screen">
        <!-- 訂閱上方統一發布出來的 ROS Topic -->
        <param name="image_topic" value="/camera/image_raw" />
        <param name="pub_topic" value="lane_detect" />
        <param name="debug_topic" value="lane_detect/image_out" />
        <param name="show_window" value="false" />
        
        <!-- Algorithm Configurations -->
        <param name="strict_roi" value="true" />
        <param name="min_contour_area" value="500.0" />
        <param name="anchor_ratio" value="0.8" />
        <param name="lane_width_history_len" value="30" />
        <param name="enable_yaw_b" value="true" />
        <param name="max_predict_frames" value="15" />

        <!-- Binarization & Morphological Parameters -->
        <param name="use_otsu_fallback" value="true" />
        <param name="adaptive_block_size" value="25" />
        <param name="adaptive_c" value="10" />
        <param name="blur_kernel" value="5" />
        <param name="morph_open_kernel" value="3" />
        <param name="morph_close_kernel" value="9" />
    </node>

    <!-- 轉彎辨識節點 -->
    <node pkg="lane_follower" type="turn_detect.py" name="turn_detect_node" output="screen">
        <param name="image_topic" value="/camera2/image_raw" />
        <param name="debug_topic" value="turn_detect/image_out" />
        <param name="show_window" value="false" />
        <!-- 二值化 threshold：'fixed' (推薦) / 'otsu' / 'adaptive'
             threshold_value 越小越只抓「真的黑」；灰被當黑 → 調小 -->
        <param name="threshold_method" value="fixed" />
        <param name="threshold_value" value="60" />
        <param name="invert_binary" value="true" />
    </node>

    <!-- 模糊控制節點 -->
    <node pkg="lane_follower" type="lane_controller_fuzzy.py" name="lane_controller_fuzzy" output="screen">
        <param name="base_speed" value="0.3" />
        <param name="max_angular" value="1.2" />
        
        <!-- 第一次大轉彎參數 -->
        <param name="turn_pixel_threshold_1" value="20000.0" />
        <param name="hard_turn_angular_1" value="1.8" />        
        <param name="hard_turn_duration_1" value="0.9" />    
        
        <!-- 第二次大轉彎參數 -->
        <param name="turn_pixel_threshold_2" value="20000.0" />
        <param name="hard_turn_angular_2" value="1.8" />        
        <param name="hard_turn_duration_2" value="1.2" />  

        <param name="hard_turn_cooldown" value="1" />
        <param name="sign_detect_pixel_threshold" value="13000.0" />
        <param name="sign_offset_threshold" value="50.0" />
        <param name="sign_align_angular" value="0.2" />

        <!-- 第一次大轉彎後 X 秒的排程同向硬轉 -->
        <param name="scheduled_turn_delay" value="5.3" />
        <param name="scheduled_turn_angular" value="1.8" />
        <param name="scheduled_turn_duration" value="0.9" />

        <!-- 丟失路標尋找：先倒退、再左右掃描 -->
        <!-- lost_sign_backup_speed：倒退速度 (m/s)，lost_sign_backup_duration：倒退時間 (s) -->
        <param name="lost_sign_backup_speed" value="0.1" />
        <param name="lost_sign_backup_duration" value="0.8" />
        <!-- scan_angular_z：倒退後左右掃描的擺動角速度 (rad/s)，越大擺幅越大 -->
        <param name="scan_angular_z" value="1.0" />
    </node>
</launch>
