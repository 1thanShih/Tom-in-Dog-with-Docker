<!--
  任務整合 launch：走線 -> 第 3 次硬轉完停車 -> 光達避障

  流程：
    1. 啟動時 lane_controller_fuzzy 發 /mission/phase = "lane" (latched)
    2. lidar_odom_nav 看到非 "lidar_avoid" 的 phase，停在 S_IDLE 不發 cmd_vel
    3. 走線 + 硬轉到 hard_turn_count == 3
    4. 第 3 次硬轉完 -> 停車 handoff_stop_duration 秒 -> 發 /mission/phase = "lidar_avoid"
    5. lane_controller_fuzzy 之後靜音；lidar_odom_nav 從 S_FWD_1 起跑接管底盤

  啟動：
    roslaunch main_control mission_bringup.launch
-->
<launch>

  <!-- ============ 共用參數 ============ -->
  <arg name="use_two_cameras" default="true"/>

  <!-- Camera 1 (前視，循線) -->
  <arg name="cam1_fps"    default="30"/>
  <arg name="cam1_width"  default="640"/>
  <arg name="cam1_height" default="480"/>

  <!-- Camera 2 (轉彎標誌) -->
  <arg name="cam2_fps"    default="30"/>
  <arg name="cam2_width"  default="640"/>
  <arg name="cam2_height" default="480"/>

  <!-- 底盤 cmd_vel topic -->
  <arg name="cmd_vel_topic" default="/arduino_vel"/>

  <!-- 光達擷取扇形 -->
  <arg name="front_angle_range"      default="5.0"/>
  <arg name="front_angle_offset_deg" default="180.0"/>

  <!-- 里程計參數 -->
  <arg name="wheel_radius"  default="0.0331"/>
  <arg name="wheel_base"    default="0.166"/>
  <arg name="ticks_per_rev" default="390.3"/>

  <!-- 避障速度 -->
  <arg name="nav_v_linear"  default="0.30"/>
  <arg name="nav_v_angular" default="1.0"/>

  <!-- 任務交棒參數（交棒由 T3_FORWARD 完成自動觸發） -->
  <arg name="handoff_stop_duration"   default="1.0"/>

  <!-- 紅綠燈等待（緩衝停車後、交棒給光達避障前） -->
  <arg name="traffic_light_topic"             default="/traffic_light"/>
  <arg name="traffic_light_no_detect_timeout" default="5.0"/>

  <!-- 第 3 次 visual 轉彎新流程（取代寫死 hard turn） -->
  <arg name="turn_pixel_threshold_3"   default="8000.0"/>
  <arg name="t3_ultrasonic_threshold"  default="4"/>     <!-- cm -->
  <arg name="t3_approach_speed"        default="0.15"/>     <!-- m/s -->
  <arg name="t3_odom_turn_angular"     default="1.0"/>     <!-- rad/s -->
  <arg name="t3_odom_turn_tol_deg"     default="5.0"/>     <!-- deg -->
  <arg name="t3_align_angular"         default="0.4"/>     <!-- rad/s -->
  <arg name="t3_align_tol_deg"         default="3.0"/>     <!-- deg -->
  <arg name="t3_align_timeout"         default="2.0"/>     <!-- s -->
  <arg name="t3_forward_speed"         default="0.15"/>    <!-- m/s -->
  <arg name="t3_forward_dist"          default="0.10"/>     <!-- m -->

  <!-- 超音波停車（走線最前 X 秒內偵測停止標示，遇到後停車；標示移走後恢復且不再偵測） -->
  <!-- ultrasonic_initial_blank: watch 視窗開頭忽略超音波讀數的秒數（過濾啟動瞬間雜訊） -->
  <!-- ultrasonic_stable_count: 連續幾次 < stop_threshold 才視為真正觸發停車（過濾車道校正時誤照牆壁） -->
  <arg name="ultrasonic_topic"              default="/ultrasonic"/>
  <arg name="ultrasonic_watch_duration"     default="10.0"/>
  <arg name="ultrasonic_stop_threshold"     default="20.0"/>
  <arg name="ultrasonic_resume_threshold"   default="25.0"/>
  <arg name="ultrasonic_initial_blank"      default="2.0"/>
  <arg name="ultrasonic_stable_count"       default="3"/>

  <!-- 丟失路標時的找標流程：先倒退 backup_duration 秒，再切到左右掃描 -->
  <arg name="lost_sign_backup_duration"     default="0.8"/>
  <arg name="lost_sign_backup_speed"        default="0.2"/>


  <!-- ============ 共用底層：rosserial ============ -->
  <node pkg="rosserial_python" type="serial_node.py" name="arduino_mega_serial_node" output="screen">
    <param name="port" value="/dev/ttyUSB0"/>
    <param name="baud" value="115200"/>
  </node>


  <!-- ============ 攝影機（走線階段使用，避障階段保留運轉） ============ -->
  <node name="camera1" pkg="camera" type="camera.py" output="screen">
    <param name="camera_id"   value="/dev/video0"/>
    <param name="camera_name" value="camera"/>
    <param name="frame_rate"  value="$(arg cam1_fps)"/>
    <param name="width"       value="$(arg cam1_width)"/>
    <param name="height"      value="$(arg cam1_height)"/>
  </node>

  <node name="camera2" pkg="camera" type="camera.py" output="screen" if="$(arg use_two_cameras)">
    <param name="camera_id"   value="/dev/video2"/>
    <param name="camera_name" value="camera2"/>
    <param name="frame_rate"  value="$(arg cam2_fps)"/>
    <param name="width"       value="$(arg cam2_width)"/>
    <param name="height"      value="$(arg cam2_height)"/>
  </node>


  <!-- ============ 紅綠燈感測器（Grove Vision AI V2, USB-C 串列） ============ -->
  <include file="$(find traffic_light)/launch/traffic_light.launch"/>


  <!-- ============ 光達 driver + 前處理（暖機，切換零延遲） ============ -->
  <include file="$(find rplidar_ros)/launch/rplidar_a1.launch"/>

  <node pkg="nav_scripts" type="lidar_filter_node.py" name="lidar_filter_node" output="screen">
    <param name="front_angle_range"      value="$(arg front_angle_range)"/>
    <param name="front_angle_offset_deg" value="$(arg front_angle_offset_deg)"/>
    <param name="max_valid_range"        value="12.0"/>
    <remap from="/scan"         to="/scan"/>
    <remap from="/lidar_output" to="/lidar_output"/>
  </node>


  <!-- ============ 里程計（兩階段都需要） ============ -->
  <node pkg="nav_scripts" type="odometry_node.py" name="odometry_node" output="screen">
    <param name="wheel_radius"  value="$(arg wheel_radius)"/>
    <param name="wheel_base"    value="$(arg wheel_base)"/>
    <param name="ticks_per_rev" value="$(arg ticks_per_rev)"/>
    <param name="odom_frame"    value="odom"/>
    <param name="base_frame"    value="base_link"/>
    <param name="publish_tf"    value="true"/>
    <remap from="/encoders" to="/encoders"/>
    <remap from="/odometry" to="/odometry"/>
  </node>


  <!-- ============ 階段一：走線 ============ -->
  <node pkg="lane_follower" type="lane_detect_v2.py" name="lane_detect_node" output="screen">
    <param name="image_topic"  value="/camera2/image_raw"/>
    <param name="pub_topic"    value="lane_detect"/>
    <param name="debug_topic"  value="lane_detect/image_out"/>
    <param name="show_window"  value="false"/>

    <param name="strict_roi"            value="true"/>
    <param name="min_contour_area"      value="500.0"/>
    <param name="anchor_ratio"          value="0.83"/>
    <param name="lane_width_history_len" value="30"/>
    <param name="enable_yaw_b"          value="true"/>
    <param name="max_predict_frames"    value="15"/>

    <param name="use_otsu_fallback"   value="true"/>
    <param name="adaptive_block_size" value="25"/>
    <param name="adaptive_c"          value="10"/>
    <param name="blur_kernel"         value="5"/>
    <param name="morph_open_kernel"   value="3"/>
    <param name="morph_close_kernel"  value="9"/>
  </node>

  <node pkg="lane_follower" type="turn_detect.py" name="turn_detect_node" output="screen">
    <param name="image_topic" value="/camera/image_raw"/>
    <param name="debug_topic" value="turn_detect/image_out"/>
    <param name="show_window" value="false"/>
    <!-- 二值化 threshold：'fixed' (推薦) / 'otsu' / 'adaptive'
         threshold_value 越小越只抓「真的黑」；灰被當黑 → 調小 -->
    <param name="threshold_method" value="fixed"/>
    <param name="threshold_value" value="70"/>
    <param name="invert_binary" value="true"/>
  </node>

  <node pkg="lane_follower" type="lane_controller_fuzzy.py" name="lane_controller_fuzzy" output="screen">
    <param name="base_speed"  value="0.3"/>
    <param name="max_angular" value="1.1"/>

    <param name="turn_pixel_threshold_1" value="25000.0"/>
    <param name="hard_turn_angular_1"    value="1.7"/>
    <param name="hard_turn_duration_1"   value="0.75"/>

    <param name="turn_pixel_threshold_2" value="25000.0"/>
    <param name="hard_turn_angular_2"    value="1.8"/>
    <param name="hard_turn_duration_2"   value="1.0"/>

    <param name="hard_turn_cooldown"           value="1"/>
    <param name="sign_detect_pixel_threshold"  value="8000.0"/>
    <param name="sign_offset_threshold"        value="50.0"/>
    <param name="sign_align_angular"           value="0.2"/>

    <param name="scheduled_turn_delay"    value="4.6"/>
    <param name="scheduled_turn_angular"  value="1.81"/>
    <param name="scheduled_turn_duration" value="0.93"/>

    <!-- 第二段 scheduled turn：在第 2 次 vision 硬轉完成後 delay 秒，再做一次同方向硬轉 -->
    <param name="scheduled_turn_delay_2"    value="3.2"/>
    <param name="scheduled_turn_angular_2"  value="0.9"/>
    <param name="scheduled_turn_duration_2" value="0.5"/>

    <!-- 任務交棒緩衝停車時間（T3_FORWARD 完成 -> 停這麼久 -> 進紅綠燈等待） -->
    <param name="handoff_stop_duration"   value="$(arg handoff_stop_duration)"/>

    <!-- 超音波停車（僅生效一次，視窗內 < stop 連續 stable_count 次停車，>= resume 解除並關閉偵測） -->
    <param name="ultrasonic_topic"            value="$(arg ultrasonic_topic)"/>
    <param name="ultrasonic_watch_duration"   value="$(arg ultrasonic_watch_duration)"/>
    <param name="ultrasonic_stop_threshold"   value="$(arg ultrasonic_stop_threshold)"/>
    <param name="ultrasonic_resume_threshold" value="$(arg ultrasonic_resume_threshold)"/>
    <param name="ultrasonic_initial_blank"    value="$(arg ultrasonic_initial_blank)"/>
    <param name="ultrasonic_stable_count"     value="$(arg ultrasonic_stable_count)"/>

    <!-- 丟失路標時的找標流程：先倒退 backup_duration 秒，再切到左右掃描 -->
    <param name="lost_sign_backup_duration"   value="$(arg lost_sign_backup_duration)"/>
    <param name="lost_sign_backup_speed"      value="$(arg lost_sign_backup_speed)"/>

    <!-- 紅綠燈等待：handoff 緩衝停車後進入，green 或連續 no_detect_timeout 秒無偵測即放行 -->
    <param name="traffic_light_topic"             value="$(arg traffic_light_topic)"/>
    <param name="traffic_light_no_detect_timeout" value="$(arg traffic_light_no_detect_timeout)"/>

    <!-- 第 3 次 visual 轉彎新流程：T3_APPROACH -> T3_TURN(odom 90°) -> T3_ALIGN -> T3_FORWARD -> handoff -->
    <param name="turn_pixel_threshold_3"  value="$(arg turn_pixel_threshold_3)"/>
    <param name="t3_ultrasonic_threshold" value="$(arg t3_ultrasonic_threshold)"/>
    <param name="t3_approach_speed"       value="$(arg t3_approach_speed)"/>
    <param name="t3_odom_turn_angular"    value="$(arg t3_odom_turn_angular)"/>
    <param name="t3_odom_turn_tol_deg"    value="$(arg t3_odom_turn_tol_deg)"/>
    <param name="t3_align_angular"        value="$(arg t3_align_angular)"/>
    <param name="t3_align_tol_deg"        value="$(arg t3_align_tol_deg)"/>
    <param name="t3_align_timeout"        value="$(arg t3_align_timeout)"/>
    <param name="t3_forward_speed"        value="$(arg t3_forward_speed)"/>
    <param name="t3_forward_dist"         value="$(arg t3_forward_dist)"/>

    <remap from="arduino_vel" to="$(arg cmd_vel_topic)"/>
  </node>


  <!-- ============ 階段二：光達避障（啟動時停在 S_IDLE） ============ -->
  <node pkg="nav_scripts" type="lidar_odom_nav_node.py" name="lidar_odom_nav_node" output="screen">
    <param name="wait_for_phase" value="true"/>
    <param name="trigger_phase"  value="lidar_avoid"/>

    <param name="v_linear"  value="$(arg nav_v_linear)"/>
    <param name="v_angular" value="$(arg nav_v_angular)"/>
    <param name="dist_th_1" value="0.30"/>
    <param name="dist_th_2" value="0.30"/>
    <param name="dist_th_3" value="0.45"/>
    <param name="dist_th_4" value="0.60"/>
    <param name="turn_overshoot_deg" value="10.0"/>
    <param name="turn_tol_deg"       value="2.0"/>
    <param name="brake_duration"     value="0.3"/>
    <param name="rate_hz"            value="20.0"/>

    <remap from="/cmd_vel"      to="$(arg cmd_vel_topic)"/>
    <remap from="/lidar_output" to="/lidar_output"/>
    <remap from="/odometry"     to="/odometry"/>
  </node>

</launch>
